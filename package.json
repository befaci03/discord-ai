{
  "name": "discord-ai",
  "version": "0.1.0",
  "description": "An Agent in a Discord server... (simple as that)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "trustedDependencies": ["bcrypt"],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "bcrypt": "^6.0.0",
    "cassandra-driver": "^4.10.0",
    "discord.js": "^14.27.0",
    "docker-compose": "^1.4.2",
    "is-docker": "^4.0.0",
    "mariadb": "^3.5.4",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.0.14",
    "openai": "^7.5.0",
    "pg": "^8.23.1",
    "toml": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.6",
    "prettier-plugin-toml": "^2.0.6",
    "typescript": "^7.0.2"
  }
}
